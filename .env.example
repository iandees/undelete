R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=osm-undelete
R2_PUBLIC_URL=
RETENTION_DAYS=90
PARQUET_BUILD_INTERVAL=300
DATA_DIR=./data
# Optional limit on catch-up. Unset captures every change since the last one processed, however
# long the daemon was down (about 3.5 hours of API time per day of backlog). Set a number of
# days to skip ahead instead, which leaves a gap in the data.
CATCHUP_MAX_DAYS=
# Minimum seconds between OSM API requests
OSM_API_MIN_INTERVAL=0.5
# Identify yourself to the OSM API, e.g. "osm-undelete/0.1 (you@example.com)"
OSM_USER_AGENT=
# Where replication files come from. planet.openstreetmap.org redirects every request to an AWS
# S3 bucket, and that host times out when several connections open at once (urllib3 "Retrying"
# warnings). "s3" (the default) fetches from the bucket directly; "planet" goes through the host.
REPLICATION_MIRROR=s3
# Parallel downloads when catching up on changeset replication. 4 is ~23 files/s from the S3
# mirror; 8 is ~43/s. Keep it at 4 or lower with REPLICATION_MIRROR=planet.
CHANGESET_WORKERS=4
# DEBUG adds per-sequence changeset detail
LOG_LEVEL=INFO
# Changesets are filed by creation date and a date is published this many days after it starts
# (open changesets can change for ~24h). Later updates, almost always a new comment on an old
# changeset, are merged into the published file rather than dropped.
CHANGESET_SETTLE_DAYS=2
# Late rows for a day that is already published are merged into it at most this often (seconds)
LATE_MERGE_INTERVAL=3600
